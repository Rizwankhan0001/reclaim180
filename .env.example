# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (TiDB Cloud): mysql://2abc.root:PASSWORD@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/reclaim180
# If the password has special characters (@ : / # ? &), URL-encode them, e.g. @ becomes %40.
DATABASE_URL=""

# SSL is on automatically for every host except localhost. Set to "false" only for a private network server.
# DATABASE_SSL="false"

# Random 32+ character secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The app's public URL. Optional on Vercel (the production URL is used automatically).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google sign-in. The button appears once both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
