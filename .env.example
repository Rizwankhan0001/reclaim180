# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Neon connection string (use the pooled one, it contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Random 32+ character secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The app's public URL. Optional on Vercel (the production URL is used automatically).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google sign-in. The button appears once both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
