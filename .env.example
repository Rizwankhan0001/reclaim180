# Copy to .env.local for local development. On Netlify, set these under Site configuration → Environment variables.

# MySQL / TiDB Cloud connection string. TLS is used automatically for non-localhost hosts.
DATABASE_URL="mysql://USER:PASSWORD@gateway01.REGION.prod.aws.tidbcloud.com:4000/reclaim180"

# Random 32+ character secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The app's public URL. Optional on Netlify (the site URL is detected automatically).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google sign-in. The button appears once both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
